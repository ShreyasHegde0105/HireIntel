# Copy to .env and fill in. Never commit .env.

# Gemini API key from https://aistudio.google.com/ (free tier: use synthetic resumes only)
GEMINI_API_KEY=your_actual_gemini_api_key_here

# Local server
PORT=8000
HOST=127.0.0.1

# Optional overrides (defaults shown)
# GENERATION_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
# EMBEDDING_MODEL=gemini-embedding-2
# MAX_FILES=10
# MAX_FILE_SIZE_MB=5
# RATE_LIMIT_PER_MINUTE=3
# RATE_LIMIT_PER_DAY=20
# DAILY_RESUME_BUDGET=150
# DEMO_ACCESS_CODE=          # set to require a code before analysing
# CORS_ORIGINS=              # only if the frontend is hosted on a different domain
# LOG_LEVEL=INFO
